<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleExecutable</key>
    <string>SonosController</string>
    <key>CFBundleIdentifier</key>
    <string>com.curtisblackwell.sonos-controller</string>
    <key>CFBundleName</key>
    <string>SonosController</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>1.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>LSMinimumSystemVersion</key>
    <string>14.0</string>
    <key>NSLocalNetworkUsageDescription</key>
    <string>SonosController finds your Sonos speakers on this network and sends them play, pause, and track commands.</string>
    <key>NSHighResolutionCapable</key>
    <true/>
    <!-- Substituted by Scripts/build-app.sh from the SPOTIFY_CLIENT_ID environment
         variable - never hardcoded here, so an open-source checkout never ships someone
         else's client id. -->
    <key>SpotifyClientID</key>
    <string>__SPOTIFY_CLIENT_ID__</string>
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key>
            <string>com.curtisblackwell.sonos-controller.spotify-auth</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>sonos-controller</string>
            </array>
        </dict>
    </array>
    <!-- Payload for dragging a room between groups in the editor. Declared so the drag
         type is registered rather than synthesised at runtime; it is app-internal and
         deliberately not associated with any file extension. -->
    <key>UTExportedTypeDeclarations</key>
    <array>
        <dict>
            <key>UTTypeIdentifier</key>
            <string>com.curtisblackwell.sonos-controller.room</string>
            <key>UTTypeDescription</key>
            <string>Sonos Room</string>
            <key>UTTypeConformsTo</key>
            <array>
                <string>public.data</string>
            </array>
        </dict>
    </array>
</dict>
</plist>
